# GEMINI_API_KEY: Optional for AI integrations if enabled by user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT Signing Secrets (override in production via environment secrets)
JWT_SECRET="replace_with_long_random_secret_in_production"
JWT_REFRESH_SECRET="replace_with_different_long_random_refresh_secret"

# SQLite Database Path (local relational storage; PostgreSQL adapter ready for production)
DATABASE_PATH="./data/careone.db"

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN="http://localhost:3000"

# Razorpay Payment Gateway (Sandbox mode used when keys are not configured)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
